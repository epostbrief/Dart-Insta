# Dependencies & Build
node_modules/
dist/

# Crawler: Cache und Raw-HTML werden standardmäßig NICHT committed
# (Raw-HTML kann pro Lauf recht groß werden). data/parsed/*.json wird
# bewusst NICHT ignoriert — das sind die Daten, die die App nutzt.
data/cache/
data/raw/

# Design-Canvas: die zusammengesetzte Datei ist generiert (~2,5 MB, enthält
# den kompletten Editor) und wird aus den .dc.html-Quellen neu erzeugt.
design/*.html
!design/*.dc.html

# Logs
npm-debug.log*
*.log

# Editor/OS
.DS_Store
.vscode/
.idea/

# Env
.env
.env.local
